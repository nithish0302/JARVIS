JARVIS_HOST=0.0.0.0
JARVIS_PORT=8765
# Ollama is fully optional - leave OLLAMA_HOST empty to run on cloud
# providers only (Gemini/Groq/OpenRouter below). Set it (e.g.
# http://192.168.1.x:11434) only if you're running your own Ollama
# instance; it's silently left out of the provider cascade otherwise.
OLLAMA_HOST=
OLLAMA_MODEL=llama3.2:3b
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemma-4-27b-it:free
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=compound-beta
TAVILY_API_KEY=your_tavily_api_key_here
SEARCH_PROVIDER=tavily
DB_PATH=data/jarvis.db
VERSION=0.1.0
WAKE_WORD_MODEL_PATH=models/wake_up_jarvis.onnx

# TTS Configuration
TTS_ENGINE=chatterbox
CHATTERBOX_VOICE_PATH=D:/JARVIS/JARVIS voice.mp3
CHATTERBOX_EXAGGERATION=0.5
CHATTERBOX_CFG_WEIGHT=0.5
CHATTERBOX_DEVICE=cpu
CHATTERBOX_REPETITION_PENALTY=1.1

# Free models available at:
# https://openrouter.ai/models?q=:free
